# ===== P2 运行时外部服务配置（复制为 .env 并填入真实值）=====
# 注意：.env 含密钥，已被 .gitignore 忽略，切勿提交。
# 任意一组留空 → 对应组件自动回退确定性桩（离线、零费用、可复现）。

# --- 1) 检索 / 引用 API ---
# 检索服务地址（留空回退确定性桩）
P1_RAG_BASE_URL=
# 鉴权密钥（请求头 X-API-Key）
RAG_API_KEY=
# 证据 score 阈值：低于此值视为低质量召回，不采纳
P1_RAG_SCORE_THRESHOLD=0.3
# 单次检索返回条数上限
P1_RAG_LIMIT=8
# 单次检索超时（秒）
P1_RAG_TIMEOUT=10

# --- 2) 真实 LLM API（驱动 Planner / Analyst / Writer / Reviewer）---
# 任意 OpenAI 兼容端点，例如：
#   DeepSeek:  https://api.deepseek.com/v1
#   通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM:  https://open.bigmodel.cn/api/paas/v4
#   OpenAI:    https://api.openai.com/v1
LLM_BASE_URL=
# 服务商发放的 API Key
LLM_API_KEY=
# 模型名，例如 deepseek-chat / qwen-plus / glm-4-flash / gpt-4o-mini
LLM_MODEL=
# 生成温度（0=更稳，1=更发散；方案写作建议偏低值）
LLM_TEMPERATURE=0.3
# 单次调用超时（秒）。生成长文的思考型模型需给足，过短会触发重试风暴
LLM_TIMEOUT=120
# 单次输出 token 上限，控制延迟与成本
LLM_MAX_TOKENS=2048
