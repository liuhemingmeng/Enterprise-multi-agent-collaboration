# ===== P2 运行时外部服务配置（复制为 .env 并填入真实值）=====
# 注意：.env 含密钥，已被 .gitignore 忽略，切勿提交。

# --- 1) P1 检索/引用 API（已部署，仅做客户端，无需 P1 改代码）---
# 公网地址（部署完成后可能变化，以实际为准）
P1_RAG_BASE_URL=http://101.245.96.205
# P1 鉴权密钥（单 key 模式，与 HR 共用；填入你给的 RAG_API_KEY）
RAG_API_KEY=
# 证据 score 阈值：低于此值视为低质量，不采纳（P1 永返空数组，必须靠阈值过滤）
P1_RAG_SCORE_THRESHOLD=0.3
# 单次检索返回条数（P1 上限 10）
P1_RAG_LIMIT=8
# 单次检索超时（秒）
P1_RAG_TIMEOUT=10

# --- 2) 真实 LLM API（驱动 Planner/Analyst/Writer/Reviewer 四个生成型智能体）---
# 任意 OpenAI 兼容端点，例如：
#   DeepSeek:  https://api.deepseek.com/v1
#   通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM:  https://open.bigmodel.cn/api/paas/v4
#   OpenAI:    https://api.openai.com/v1
LLM_BASE_URL=
# 服务商发放的 API Key
LLM_API_KEY=
# 模型名，例如 deepseek-chat / qwen-plus / glm-4-flash / gpt-4o-mini
LLM_MODEL=
# 生成温度（0=更稳，1=更发散）
LLM_TEMPERATURE=0.3
# 单次调用超时（秒）
LLM_TIMEOUT=30
